# ============================================================================
# TerraSense AI Backend — Environment Variables
# Copy this file to `.env` in this same folder for local development.
# NEVER commit a real .env file. In production (Render), set these in the
# service's Environment tab instead.
# ============================================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terrasense
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=https://terrasenseai.netlify.app,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=https://terrasenseai.netlify.app

MODEL_PATH=./models/landslide_pipeline.joblib
MODEL_METADATA_PATH=./models/model_metadata.json
ARTIFACTS_DIR=./artifacts
DATASET_PATH=./data/global_landslide_catalog.csv

RISK_THRESHOLD_MEDIUM=0.35
RISK_THRESHOLD_HIGH=0.65

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=30

# Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email delivery via a Google Apps Script Web App (see README "Email Setup"
# section for step-by-step instructions on creating this).
APPS_SCRIPT_EMAIL_URL=
APPS_SCRIPT_SHARED_SECRET=

LOG_LEVEL=INFO

# --- Geospatial Data Engine (live location-based prediction) ---
# All defaults below are free, keyless public APIs. No API keys or signup
# are required to run this locally.
# Set MOCK_EXTERNAL_APIS=true to run a fully offline demo (no internet
# needed) with clearly-labeled deterministic demo data -- useful if your
# college demo doesn't have reliable wifi. Never leave this "true" in a
# real deployment.
MOCK_EXTERNAL_APIS=false

OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

GEO_HTTP_TIMEOUT_SECONDS=12
GEO_CACHE_TTL_MINUTES=30
GEO_CACHE_COORD_PRECISION=3
DEFAULT_ANALYSIS_RADIUS_KM=5
MAX_ANALYSIS_RADIUS_KM=25

# --- Email Alert Monitoring (spec sections 37-43) ---
# Reuses the same APPS_SCRIPT_EMAIL_URL already configured above for
# password-reset emails (see app/services/email_service.py).
MONITORING_ENABLED=true
MONITORING_INTERVAL_MINUTES=15
DEFAULT_ALERT_THRESHOLD=0.65
DEFAULT_RESET_THRESHOLD=0.50
DEFAULT_ALERT_COOLDOWN_MINUTES=360
MAX_ACTIVE_SUBSCRIPTIONS_PER_USER=5

# --- Home page "last 12 months" 3D terrain ---
# true  = try NASA's live public landslide layer first, fall back to the bundled catalog
# false = always use the bundled catalog (offline demos)
RECENT_LANDSLIDES_LIVE=true
RECENT_LANDSLIDES_CACHE_HOURS=6

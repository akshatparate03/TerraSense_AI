# ============================================================================
# TerraSense AI Backend — Environment Variables
# Copy this file to `.env` in this same folder for local development.
# NEVER commit a real .env file. In production (Render), set these in the
# service's Environment tab instead.
# ============================================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terrasense
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=https://terrasenseai.netlify.app,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=https://terrasenseai.netlify.app

MODEL_PATH=./models/landslide_pipeline.joblib
MODEL_METADATA_PATH=./models/model_metadata.json
ARTIFACTS_DIR=./artifacts
DATASET_PATH=./data/global_landslide_catalog.csv

RISK_THRESHOLD_MEDIUM=0.35
RISK_THRESHOLD_HIGH=0.65

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=30

# Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email delivery via a Google Apps Script Web App (see README "Email Setup"
# section for step-by-step instructions on creating this).
APPS_SCRIPT_EMAIL_URL=
APPS_SCRIPT_SHARED_SECRET=

LOG_LEVEL=INFO

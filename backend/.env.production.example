# ============================================================================
# TerraSense AI Backend — PRODUCTION environment for Render
#
# How to use: Render dashboard -> your Web Service -> Environment ->
# "Add from .env" -> paste everything below, then replace the 4 values marked
# <<< FILL >>> . Everything else is already set for
#   Frontend : https://terrasenseai.netlify.app
#   Backend  : https://terrasenseai-backend.onrender.com
# This file contains NO real secrets, so it is safe to commit.
# ============================================================================

# --- Python version (Render's default is newer than the pinned packages support) ---
PYTHON_VERSION=3.12.8

# --- Database: Neon connection string  <<< FILL >>>
# Neon dashboard -> Connect -> copy the string, e.g.
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=<<< FILL >>>

# --- URLs / CORS (already correct) ---
CORS_ORIGINS=https://terrasenseai.netlify.app
FRONTEND_URL=https://terrasenseai.netlify.app

# --- ML files (relative to backend/, already in the repo) ---
MODEL_PATH=./models/landslide_pipeline.joblib
MODEL_METADATA_PATH=./models/model_metadata.json
ARTIFACTS_DIR=./artifacts
DATASET_PATH=./data/global_landslide_catalog.csv
RISK_THRESHOLD_MEDIUM=0.35
RISK_THRESHOLD_HIGH=0.65

# --- Auth ---
# <<< FILL >>> a NEW long random string (generate: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=<<< FILL >>>
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=30
GOOGLE_CLIENT_ID=299704942538-63727r58e5ckgpppt55ffeldp6eva28o.apps.googleusercontent.com

# --- Email (Google Apps Script) — copy BOTH values from your local backend/.env  <<< FILL >>>
APPS_SCRIPT_EMAIL_URL=<<< FILL >>>
APPS_SCRIPT_SHARED_SECRET=<<< FILL >>>
CONTACT_FORM_TO_EMAIL=akshatparate@email.com

# --- Behaviour ---
LOG_LEVEL=INFO
MOCK_EXTERNAL_APIS=false
MONITORING_ENABLED=true
MONITORING_INTERVAL_MINUTES=15

# --- Live data sources (free, no keys) ---
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
GEO_HTTP_TIMEOUT_SECONDS=12
GEO_CACHE_TTL_MINUTES=30
GEO_CACHE_COORD_PRECISION=3
DEFAULT_ANALYSIS_RADIUS_KM=5
MAX_ANALYSIS_RADIUS_KM=25

# --- Home page "last 12 months" 3D terrain ---
RECENT_LANDSLIDES_LIVE=true
RECENT_LANDSLIDES_CACHE_HOURS=6

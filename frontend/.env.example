# ============================================================================
# TerraSense AI Frontend — Environment Variables
# Copy this file to `.env` in this same folder for local development.
#
# NOT NEEDED for local dev by default: Vite's dev-server proxy (vite.config.js)
# forwards /api and /ws to localhost:8000 automatically.
#
# REQUIRED in production (Netlify): set these in
# Site settings -> Environment variables.
# ============================================================================

VITE_API_BASE_URL=https://terrasenseai-backend.onrender.com/api
VITE_WS_BASE_URL=wss://terrasenseai-backend.onrender.com/ws/monitoring
VITE_GOOGLE_CLIENT_ID=

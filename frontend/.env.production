# ============================================================================
# TerraSense AI Frontend — PRODUCTION build settings (Netlify)
# Vite automatically loads this file when you run `npm run build`, so nothing
# needs to be typed into the Netlify dashboard. These are PUBLIC values (they
# end up inside the built JavaScript anyway) — never put secrets in a VITE_ var.
# ============================================================================

VITE_API_BASE_URL=https://terrasenseai-backend.onrender.com/api
VITE_WS_BASE_URL=wss://terrasenseai-backend.onrender.com/ws/monitoring

# Public Google OAuth Web Client ID (same one used by the backend)
VITE_GOOGLE_CLIENT_ID=299704942538-63727r58e5ckgpppt55ffeldp6eva28o.apps.googleusercontent.com
